# Supabase Configuration
# Copy this file to .env and fill in values from
# Supabase Dashboard → Project Settings → API
# GitHub Pages keeps working with built-in fallbacks until these are set.
# Do not commit real keys.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Optional. Web OAuth client ID from Google Cloud Console.
# You can also paste this later in Settings → Google Calendar.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
